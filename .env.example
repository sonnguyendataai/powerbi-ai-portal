APP_ENV=dev

# Power BI app-owns-data credentials
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_API_BASE_URL=https://api.powerbi.com/v1.0/myorg

# Anthropic (preferred LLM provider)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Optional MCP endpoints
POWERBI_MCP_URL=
FABRIC_CORE_MCP_URL=

# Session security
SESSION_SIGNING_SECRET=
APP_BASE_URL=http://localhost:3000

# Optional Microsoft AD OIDC SSO
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URI=http://localhost:3000/api/auth/sso/callback

# Optional local auth bootstrap admin
LOCAL_AUTH_BOOTSTRAP_USERNAME=admin
LOCAL_AUTH_BOOTSTRAP_PASSWORD=
LOCAL_AUTH_BOOTSTRAP_TENANT_ID=tenant-default

# File-backed operational store
BI_OPS_STORE_FILE=./data/bi-ops.json
# Primary DB URL (optional if POSTGRES_URL* is set by Vercel Supabase integration)
DATABASE_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Optional Supabase vars (auto-provisioned on Vercel when Supabase integration is enabled)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=

# API rate limits
CHAT_RATE_LIMIT_PER_MIN=20
EMBED_RATE_LIMIT_PER_MIN=40
